{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Dead code is a compiler error here, not something to be found by hand.
       Unused imports, locals and parameters had accumulated across every
       workspace - including whole functions written, exported and never
       called. Prefix a parameter with _ when it genuinely must exist unused. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@ascend/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src"]
}
