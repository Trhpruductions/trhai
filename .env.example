# TRHAI / Ascend AI - environment template.
# Copy this to `.env` on the machine you are running on. Every value here has a
# portable default, so an empty `.env` (or none) still runs; set a line only to
# override. Nothing here is a secret you must fill in, and no cloud key exists.

NODE_ENV=development

# --- Ports (defaults are fine; change only if something else owns them) -------
# The API. The launcher checks the port is free before starting.
PORT=4000
# The web client (trhai-web) is served on 3210. CORS must name it exactly, or
# the API falls back to "any localhost" and the real client can be blocked.
CORS_ORIGIN=http://localhost:3210,http://127.0.0.1:3210
VITE_API_BASE_URL=http://localhost:4000

# --- Local model (Ollama) -----------------------------------------------------
# The app talks to Ollama over HTTP; it never calls a cloud service.
# Leave the URL at the default unless Ollama runs elsewhere.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Which model answers. Default is "vexora:latest". On a new machine, either
#   ollama pull vexora:latest
# or set this to a model you have pulled, e.g.:
# OLLAMA_MODEL=qwen2.5-coder:7b
# With no model at all the app still runs - memory, files, schedules, app
# management and the machine readings all work; only generated replies need it.
# The context window every request asks for, in tokens. Default 16384. The
# assistant's own instructions and tool list are bigger than Ollama's default
# 4096, so anything under 8192 is raised to 8192. Lower it only if the model
# will not fit in video memory; raise it for long files.
# OLLAMA_NUM_CTX=16384

# --- Where the assistant reads and writes -------------------------------------
# Built apps, saved files and make_video output land here. Unset, it defaults to
# <your home>/Vexora/workspace, which is portable. Set an absolute path to pin a
# location on this machine (the previous machine used D:\Vexora\workspace because
# its C: drive was low on space - a per-machine choice, not something to carry over).
# ASCEND_WORKSPACE=

# --- Data at rest -------------------------------------------------------------
# If set, app-owned data files are encrypted from this key. If left unset, the
# API creates a machine-local key outside the repo and uses that. Never commit a
# real key. A .env from one machine will not decrypt another machine's data files.
# TRHAI_DATA_KEY=replace-with-a-long-local-secret

# --- Optional overrides (rarely needed) ---------------------------------------
# main.ts defaults to the web port it waits on; set only to override.
# DESKTOP_START_URL=http://localhost:3210
# Voice (Piper/whisper) and video (ffmpeg) are auto-discovered when installed
# and degrade gracefully when not; point these at custom install dirs if needed.
# VEXORA_PIPER_DIR=
# VEXORA_WHISPER_DIR=
