NODE_ENV=development
PORT=4000
# 3210 is trhai-web, the product surface. This said 5173 - the superseded
# Vite client - and pointed at a dead port; with the value set, originPolicy
# matches exactly and stops falling back to "any localhost", so the real
# client was blocked outright.
CORS_ORIGIN=http://localhost:3210,http://127.0.0.1:3210
VITE_API_BASE_URL=http://localhost:4000
# Left unset on purpose. main.ts already defaults to the web port it waits
# on, so a hardcoded URL here can only ever go stale - and it had: it still
# said 5173 after the app moved to 3210. Set it only to override.
# DESKTOP_START_URL=http://localhost:3210
