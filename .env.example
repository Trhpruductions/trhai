# TRHAI / Ascend AI - environment template.
# Copy this to `.env` on the machine you are running on. Every value here has a
# portable default, so an empty `.env` (or none) still runs; set a line only to
# override. Nothing here is a secret you must fill in, and no cloud key exists.

NODE_ENV=development

# --- Ports (defaults are fine; change only if something else owns them) -------
# The API. The launcher checks the port is free before starting.
PORT=4000
# The web client (trhai-web) is served on 3210. CORS must name it exactly, or
# the API falls back to "any localhost" and the real client can be blocked.
CORS_ORIGIN=http://localhost:3210,http://127.0.0.1:3210
VITE_API_BASE_URL=http://localhost:4000

# --- Local model --------------------------------------------------------------
# Models run in TRH AI's own engine (llama.cpp's server). The API starts and
# stops it; nothing else has to be installed or kept running, and the app never
# calls a cloud service. On a new machine, install the engine once with
#   npm run setup:engine
# and put a model - any .gguf file - in the models folder it names, which is
# %LOCALAPPDATA%\TRHAI\runtime\models unless TRHAI_RUNTIME_DIR says otherwise.
# A model that can see images goes in a folder of its own there, with its
# mmproj file beside it.
# Which model answers, by its file's name without ".gguf". With none named, the
# best of the installed ones is used.
# TRHAI_MODEL=qwen2.5-coder-7b
# With no model at all the app still runs - memory, files, schedules, app
# management and the machine readings all work; only generated replies need it.
# Each model is given the largest context window that fits the graphics card,
# and never less than 8192 tokens, which the assistant's own instructions and
# tool list need. Set this only to force one window on every model. The window
# is also the longest a single reply may be: a model that runs past it is
# stopped, and the reply is reported as too long rather than shown.
# TRHAI_CONTEXT_TOKENS=16384
# Where the engine and the models are kept. Use the fastest drive there is: a
# model loads in a few seconds from an SSD and most of a minute from a hard disk.
# TRHAI_RUNTIME_DIR=
# The port the engine listens on, on this PC's own address only.
# TRHAI_ENGINE_PORT=4040
# To use a llama.cpp server you run yourself (started with --models-preset, so
# it loads the model a request names), give its address. TRH AI then starts none.
# TRHAI_ENGINE_URL=http://127.0.0.1:8080

# --- Where the assistant reads and writes -------------------------------------
# Built apps, saved files and make_video output land here. Unset, it defaults to
# <your home>/Vexora/workspace, which is portable. Set an absolute path to pin a
# location on this machine (the previous machine used D:\Vexora\workspace because
# its C: drive was low on space - a per-machine choice, not something to carry over).
# ASCEND_WORKSPACE=

# --- Data at rest -------------------------------------------------------------
# If set, app-owned data files are encrypted from this key. If left unset, the
# API creates a machine-local key outside the repo and uses that. Never commit a
# real key. A .env from one machine will not decrypt another machine's data files.
# TRHAI_DATA_KEY=replace-with-a-long-local-secret

# --- Who can reach TRH AI -----------------------------------------------------
# The API (4000), the app (3210) and the apps TRH AI builds listen on this PC's
# own addresses only, 127.0.0.1 and ::1. "on" lets other devices on your network
# reach the API as well, and every request from one must then carry the access
# key TRH AI shows under Network. Restart TRH AI after changing it.
# ASCEND_NETWORK_ACCESS=on

# --- Optional overrides (rarely needed) ---------------------------------------
# main.ts defaults to the web port it waits on; set only to override.
# DESKTOP_START_URL=http://localhost:3210
# Voice (Piper/whisper) and video (ffmpeg) are auto-discovered when installed
# and degrade gracefully when not; point these at custom install dirs if needed.
# VEXORA_PIPER_DIR=
# VEXORA_WHISPER_DIR=
