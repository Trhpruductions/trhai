PORT=4000
CORS_ORIGIN=http://localhost:3210,http://127.0.0.1:3210
# Optional. If set, app-owned data files are encrypted from this key. If left
# unset, the API creates a machine-local key outside the repo and uses that.
# Never commit a real key value.
# TRHAI_DATA_KEY=replace-with-a-long-local-secret
