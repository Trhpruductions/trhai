{
  "appId": "com.trh.trhai",
  "productName": "TRH AI",
  "asar": true,
  "directories": {
    "output": "release"
  },
  "icon": "assets/ascend-logo",
  "files": [
    "dist/**/*",
    "renderer/**/*",
    "assets/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../api/dist",
      "to": "api",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../trhai-web/.next/standalone",
      "to": "web",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "TRH AI",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "TRH-AI-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "TRH-AI-Portable-${version}.${ext}"
  },
  "afterPack": "./afterPack.cjs",
  "extraMetadata": {
    "name": "trh-ai"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Trhpruductions",
      "repo": "trhai",
      "releaseType": "release"
    }
  ]
}
