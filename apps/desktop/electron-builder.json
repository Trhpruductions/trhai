{
  "appId": "com.trh.trhai",
  "productName": "TRH AI",
  "asar": true,
  "directories": {
    "output": "release"
  },
  "icon": "assets/ascend-logo",
  "files": [
    "dist/**/*",
    "renderer/**/*",
    "assets/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../api/dist",
      "to": "api",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../trhai-web/.next/standalone",
      "to": "web",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "TRH-AI-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "TRH-AI-Portable-${version}.${ext}"
  }
}
