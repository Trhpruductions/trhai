{
  "appId": "com.trh.ascend.desktop",
  "productName": "Vexora AI",
  "asar": true,
  "directories": {
    "output": "release"
  },
  "icon": "assets/ascend-logo",
  "files": [
    "dist/**/*",
    "renderer/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "ascend-ai-desktop-setup-${version}.${ext}"
  }
}
